# Copy to .env next to docker-compose.prod.yml on the server.

# Database password. It goes into a connection URL, so stick to letters and digits:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Port the app listens on, on the server.
APP_PORT=3000

# Image tag to run: latest, or pin a release such as 1.0.0.
REKENEN_VERSION=latest
